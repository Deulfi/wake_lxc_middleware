# wake_lxc_middleware configuration
# Proxmox credentials are loaded from environment variables (.env), not here.
#
# Containers can also be defined without this file, via Proxmox notes
# (one wake.key=value per line): enable, domain, port, host, backend
# (full URL override), stop_minutes, shutdown_minutes.
# A container listed here always wins over a discovered one with the same vmid.

global:
  shutdown_minutes: 30   # REQUIRED: graceful shutdown N minutes after last access
  check_interval: 5      # REQUIRED: watchdog poll interval, in minutes (global only)
  discovery_interval: 60 # OPTIONAL: seconds between Proxmox-notes discovery passes (default 60)
  # OPTIONAL: domain for a discovered LXC without wake.domain, built from its
  # hostname (LXC only -- QEMU VMs must set wake.domain explicitly).
  # Falls back to a template derived from WAKE_DOMAIN when not set.
  # domain_template: "{hostname}.sub.domain.name"

containers:
  - vmid: 150
    kind: lxc                   # 'lxc' or 'qemu' (default lxc)
    domain: lxc.sub.domain.name # REQUIRED: external hostname (or use 'domains' for a list)
    backend: "http://10.0.100.150:3000"  # OPTIONAL: app readiness probe; omit to skip
    shutdown_minutes: 15        # OPTIONAL: graceful shutdown after N idle minutes
    stop_minutes: 60            # OPTIONAL: hard poweroff after N idle minutes (wins over shutdown_minutes)

  - vmid: 106
    domain: n8n.sub.domain.name
    backend: "http://10.0.100.106:5678"
    shutdown_minutes: 120

# Example Traefik Configuration for the wake-lxc middleware plugin.
# Copy this file to traefik.config.yaml and update the placeholders below.
#
# The wake-lxc middleware proxies traffic: it starts a stopped container on
# the first request, serves a starting page while it boots, and proxies to
# the backend once running. No forwardAuth, no WAKE_DOMAIN, no SSE.

routers:
  docmost:
    entryPoints:
      - "websecure"
    rule: "Host(`docmost.sub.domain.name`)"
    middlewares:
      - default-headers
      - wake
    tls: {}
    service: docmost

  n8n:
    entryPoints:
      - "websecure"
    rule: "Host(`n8n.sub.domain.name`)"
    middlewares:
      - default-headers
      - wake
    tls: {}
    service: n8n

services:
  docmost:
    url: "http://<docmost-host>:3003"
  n8n:
    url: "http://<n8n-host>:5678"

middlewares:
  default-headers:
    headers:
      frameDeny: true
      browserXssFilter: true
      contentTypeNosniff: true
      forceSTSHeader: true
      stsIncludeSubdomains: true
      stsPreload: true
      stsSeconds: 31536000
      customFrameOptionsValue: "SAMEORIGIN"
      referrerPolicy: "strict-origin-when-cross-origin"
      customResponseHeaders:
        Server: ""
        X-Powered-By: ""

  # The wake-lxc plugin. All global config lives here; per-container config
  # comes from Proxmox notes (wake.* labels).
  wake:
    plugin:
      wake-lxc:
        apiEndpoint: "https://pve:8006"
        apiTokenId: "wake"
        apiToken: "YOUR_TOKEN_VALUE"
        apiValidateSSL: "false"
        apiLogging: "info"
        nodeName: "pve1"
        discoveryInterval: "60s"
        checkInterval: "5m"
        shutdownMinutes: "30"
        stateFile: "/path/to/state.json"

# Example Traefik Configuration for wake_lxc_middleware
# Copy this file to traefik.config.yaml and update the placeholders below.
# Each container in config.yaml needs a corresponding Traefik router pointing to wake-lxc.

routers:
    # Example: Route for docmost
    docmost:
      entryPoints:
        - "https"
      rule: "Host(`docmost.sub.domain.name`)"
      middlewares:
        - default-headers
        - https-redirectscheme
      tls: {}
      service: wake-lxc-proxy
    
    # Example: Route for n8n
    n8n:
      entryPoints:
        - "https"
      rule: "Host(`n8n.sub.domain.name`)"
      middlewares:
        - default-headers
        - https-redirectscheme
      tls: {}
      service: wake-lxc-proxy

services:
    # Single proxy service for all wake-lxc managed containers
    wake-lxc-proxy:
      loadBalancer:
        servers:
          - url: "http://wake-lxc:8080"
        passHostHeader: true
        healthCheck:
          path: "/healthz"
          interval: "10s"
          timeout: "5s"

middlewares:
    # HTTPS Redirect
    https-redirectscheme:
      redirectScheme:
        scheme: https
        permanent: true
        
    # Security Headers
    default-headers:
      headers:
        frameDeny: true
        browserXssFilter: true
        contentTypeNosniff: true
        forceSTSHeader: true
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: 31536000
        customFrameOptionsValue: "SAMEORIGIN"
        referrerPolicy: "strict-origin-when-cross-origin"
        customRequestHeaders:
          X-Forwarded-Proto: "https"
          X-Forwarded-Port: "443"
        customResponseHeaders:
          Server: ""
          X-Powered-By: ""

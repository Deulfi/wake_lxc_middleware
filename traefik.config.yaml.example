# Example Traefik Configuration for wake_lxc_middleware
# Copy this file to traefik.config.yaml and update the placeholders below.
# The middleware acts as a gatekeeper via forwardAuth. It does not proxy traffic.


http:
  middlewares:
    wake-lxc-auth:
      forwardAuth:
        address: "http://<middleware-host>:8080/auth"
        trustForwardHeader: true

  routers:
    wake-lxc-ui:
      rule: "Host(`wake.example.com`)"
      service: wake-lxc-middleware
      # no middlewares — this router must NOT be gated by wake-lxc-auth
      entryPoints: [websecure]
      tls: {}

    myapp:
      rule: "Host(`myapp.example.com`)"
      service: myapp
      middlewares: [wake-lxc-auth]
      entryPoints: [websecure]
      tls: {}

  services:
    myapp:
      loadBalancer:
        servers:
          - url: "http://<myapp-backend-ip>:<port>"
    wake-lxc-middleware:
      loadBalancer:
        servers:
          - url: "http://<middleware-host>:8080"

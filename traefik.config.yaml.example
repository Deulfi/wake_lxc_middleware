# Example Traefik Configuration for wake_lxc_middleware
# Copy this file to traefik.config.yaml and update the placeholders below.
# The middleware acts as a gatekeeper via forwardAuth. It does not proxy traffic.

routers:
  docmost:
    entryPoints:
      - "https"
    rule: "Host(`docmost.sub.domain.name`)"
    middlewares:
      - default-headers
      - https-redirectscheme
      - wake-lxc-middleware
    tls: {}
    service: docmost
  
  n8n:
    entryPoints:
      - "https"
    rule: "Host(`n8n.sub.domain.name`)"
    middlewares:
      - default-headers
      - https-redirectscheme
      - wake-lxc-middleware
    tls: {}
    service: n8n

services:
  docmost:
    loadBalancer:
      servers:
        - url: "http://<docmost-host>:3003"
  n8n:
    loadBalancer:
      servers:
        - url: "http://<n8n-host>:5678"

middlewares:
  https-redirectscheme:
    redirectScheme:
      scheme: https
      permanent: true
  
  default-headers:
    headers:
      frameDeny: true
      browserXssFilter: true
      contentTypeNosniff: true
      forceSTSHeader: true
      stsIncludeSubdomains: true
      stsPreload: true
      stsSeconds: 31536000
      customFrameOptionsValue: "SAMEORIGIN"
      referrerPolicy: "strict-origin-when-cross-origin"
      customRequestHeaders:
        X-Forwarded-Proto: "https"
        X-Forwarded-Port: "443"
      customResponseHeaders:
        Server: ""
        X-Powered-By: ""

  wake-lxc-middleware:
    forwardAuth:
      address: "http://wake-lxc:8000/auth"
      trustForwardHeader: true
